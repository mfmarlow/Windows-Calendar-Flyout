<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CalendarFlyout.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CalendarFlyout"
    Title="Calendar">

    <Grid x:Name="Root" KeyDown="Root_KeyDown">
        <Grid.Resources>
            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="9" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: today's date + actions -->
        <Grid Padding="20,16,12,4" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="TodayButton" Click="Today_Click" Padding="0"
                    Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="Go to today">
                <TextBlock x:Name="DateHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
            </Button>
            <Button Grid.Column="1" Click="Refresh_Click" Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Refresh">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
            <Button Grid.Column="2" Click="OpenWeb_Click" Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Open in Google Calendar">
                <FontIcon Glyph="&#xE8A7;" FontSize="14" />
            </Button>
        </Grid>

        <!-- Month grid -->
        <CalendarView x:Name="MonthView" Grid.Row="1"
                      SelectionMode="Single"
                      HorizontalAlignment="Center"
                      Background="Transparent"
                      BorderThickness="0"
                      SelectedDatesChanged="MonthView_SelectedDatesChanged"
                      CalendarViewDayItemChanging="MonthView_DayItemChanging" />

        <!-- Agenda heading -->
        <Grid Grid.Row="2" Padding="20,4,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="AgendaHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Today"
                       VerticalAlignment="Center" />
            <SelectorBar x:Name="ModeBar" Grid.Column="1" SelectionChanged="ModeBar_SelectionChanged">
                <SelectorBarItem x:Name="DayModeItem" Text="Day" IsSelected="True" />
                <SelectorBarItem x:Name="WeekModeItem" Text="Week" />
            </SelectorBar>
            <ProgressBar x:Name="Progress" Grid.ColumnSpan="2" IsIndeterminate="True" VerticalAlignment="Bottom"
                         Margin="0,0,0,-4" Visibility="Collapsed" />
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="3" Padding="8,4,8,12">
            <ListView x:Name="AgendaList"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="AgendaList_ItemClick">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <!-- Day headings in the "Week" list (ignored when the list isn't grouped). -->
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="local:AgendaGroup">
                                <TextBlock Text="{x:Bind Header}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:AgendaItem">
                        <Grid Padding="0,8" ColumnSpacing="12" Opacity="{x:Bind ItemOpacity}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Rectangle RadiusX="2" RadiusY="2" Fill="{x:Bind ColorBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Join" VerticalAlignment="Center"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Visibility="{x:Bind JoinVisibility}"
                                    Click="{x:Bind Join}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyText" Text="No events" Visibility="Collapsed"
                       HorizontalAlignment="Center" Margin="0,24,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- Shown until client_secret.json exists -->
            <StackPanel x:Name="SetupPanel" Visibility="Collapsed" Spacing="10" Padding="12,8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="One-time setup" />
                <TextBlock TextWrapping="Wrap"
                           Text="Save your Google OAuth client file (Desktop app) as client_secret.json in this folder:" />
                <TextBlock x:Name="SecretPathText" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Open folder" Click="OpenFolder_Click" />
                    <Button Content="Check again" Click="CheckAgain_Click" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>

            <!-- Shown until signed in -->
            <StackPanel x:Name="SignInPanel" Visibility="Collapsed" Spacing="12" Padding="12,8">
                <TextBlock TextWrapping="Wrap" Text="Connect your Google account to see your events here." />
                <Button x:Name="SignInButton" Content="Sign in with Google" Click="SignIn_Click"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>

            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True"
                     VerticalAlignment="Bottom" />
        </Grid>
    </Grid>
</Window>
